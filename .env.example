# ---------------------------------------------------------------------------
# PDF Intelligence — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit
# real secrets. Every variable here is read SERVER-SIDE only — none is exposed
# to the browser, which is why none is prefixed with NEXT_PUBLIC_.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------


# --- Database ---------------------------------------------------------------
# Supabase → Project Settings → Database → Connection string.
#
# DATABASE_URL uses the TRANSACTION POOLER (port 6543). Serverless functions
# open many short-lived connections and would exhaust a direct connection pool.
# DIRECT_URL uses the DIRECT connection (port 5432); drizzle-kit needs it
# because pgBouncer cannot run the DDL and advisory locks that migrations use.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"


# --- Auth -------------------------------------------------------------------
# Server-side pepper for session, share, and reset token hashes, and the key
# that encrypts share tokens at rest. Minimum 32 characters.
#
# Generate one:
#   openssl rand -base64 48
#
# WARNING: rotating this invalidates every session and makes existing share
# links unreadable for redisplay (they keep working, they just can't be copied
# again from the UI).
AUTH_SECRET="replace-me-with-at-least-32-random-characters"


# --- Storage (Supabase) -----------------------------------------------------
# Project Settings → API. The service-role key bypasses row-level security and
# is used only from server code — never send it to the browser.
#
# Create a PRIVATE bucket named `pdfs` (Storage → New bucket → Public: OFF).
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="pdfs"


# --- AI (Google Gemini) -----------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# Used for summaries, chat, and embeddings. Server-side only.
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# Optional model overrides. Defaults shown are known-good on the free tier.
#   GEMINI_CHAT_MODEL      — summaries and grounded answers
#   GEMINI_FAST_MODEL      — query rewriting and map-step notes (latency path)
#   GEMINI_EMBEDDING_MODEL — must emit 768 dims (see note below)
GEMINI_CHAT_MODEL="gemini-2.5-flash"
GEMINI_FAST_MODEL="gemini-2.5-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# NOTE: embeddings are requested at 768 dimensions because pgvector's HNSW index
# rejects anything above 2000. Changing the embedding model requires the new
# model to support 768-dim output, or a migration to change the column width and
# a re-index of every document.


# --- App URL ----------------------------------------------------------------
# Absolute origin used to build share links and password-reset links.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app  (no trailing slash)
APP_URL="http://localhost:3000"


# --- Email (OPTIONAL) -------------------------------------------------------
# Powers "notify by email when a PDF is shared". Everything works without it:
# share links are always shown in the UI for manual copying, and in development
# password-reset links are printed to the server console.
#
# Get a key at https://resend.com (free tier).
#
# LIMITATION: without a verified sending domain, Resend only delivers to the
# account owner's own address. Use `onboarding@resend.dev` as EMAIL_FROM for
# testing, or verify a domain to email anyone.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="PDF Intelligence <onboarding@resend.dev>"


# --- Testing (OPTIONAL) -----------------------------------------------------
# When set, the database integration tests run against this Postgres instead of
# being skipped. Must have the `vector` and `pg_trgm` extensions available.
#
#   docker run -d --name pdfiq-db -e POSTGRES_PASSWORD=testpass \
#     -e POSTGRES_DB=pdfiq -p 55432:5432 pgvector/pgvector:pg17
#
# TEST_DATABASE_URL="postgresql://postgres:testpass@localhost:55432/pdfiq"
