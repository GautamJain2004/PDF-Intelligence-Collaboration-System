# ---------------------------------------------------------------------------
# PDF Intelligence — environment template
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored; never commit
# real secrets. Every variable here is read SERVER-SIDE only — none is exposed
# to the browser, which is why none is prefixed with NEXT_PUBLIC_.
#
#   cp .env.example .env.local
# ---------------------------------------------------------------------------


# --- Database ---------------------------------------------------------------
# Supabase Dashboard → "Connect" (top bar). Both strings use the SAME pooler
# host; only the port differs.
#
#   DATABASE_URL → "Transaction pooler", port 6543.
#     Used by the running app. Serverless opens many short-lived connections,
#     which would exhaust a direct connection pool.
#
#   DIRECT_URL   → "Session pooler", port 5432.
#     Used by drizzle-kit for migrations, because pgBouncer's transaction mode
#     cannot run the DDL and advisory locks that migrations need.
#
# IMPORTANT: do NOT use the "Direct connection" string (db.PROJECT_REF.supabase.co).
# Supabase serves that host over IPv6 only, so on most networks it fails with
# `getaddrinfo ENOTFOUND` unless you have the IPv4 add-on. The session pooler is
# the IPv4-compatible equivalent and works for migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"


# --- Auth -------------------------------------------------------------------
# Server-side pepper for session, share, and reset token hashes, and the key
# that encrypts share tokens at rest. Minimum 32 characters.
#
# Generate one:
#   openssl rand -base64 48
#
# WARNING: rotating this invalidates every session and makes existing share
# links unreadable for redisplay (they keep working, they just can't be copied
# again from the UI).
AUTH_SECRET="replace-me-with-at-least-32-random-characters"


# --- Storage (Supabase) -----------------------------------------------------
# Project Settings → API. The service-role key bypasses row-level security and
# is used only from server code — never send it to the browser.
#
# Create a PRIVATE bucket named `pdfs` (Storage → New bucket → Public: OFF).
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="pdfs"


# --- AI (Google Gemini) -----------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# Used for summaries, chat, and embeddings. Server-side only.
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# Optional model overrides. Defaults shown are known-good on the free tier.
#   GEMINI_CHAT_MODEL      — summaries and grounded answers
#   GEMINI_FAST_MODEL      — query rewriting and map-step notes (latency path)
#   GEMINI_EMBEDDING_MODEL — must emit 768 dims (see note below)
GEMINI_CHAT_MODEL="gemini-3.5-flash"
GEMINI_FAST_MODEL="gemini-3.5-flash-lite"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
# NOTE: embeddings are requested at 768 dimensions because pgvector's HNSW index
# rejects anything above 2000. Changing the embedding model requires the new
# model to support 768-dim output, or a migration to change the column width and
# a re-index of every document.


# --- App URL ----------------------------------------------------------------
# Absolute origin used to build share links and password-reset links.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app  (no trailing slash)
APP_URL="http://localhost:3000"


# --- Email (OPTIONAL) -------------------------------------------------------
# Powers share-notification email and password-reset delivery. Everything works
# without it: share links are always shown in the UI for manual copying, and in
# development the password-reset link is printed to the server console.
#
# Two transports are supported. SMTP is used whenever SMTP_USER and SMTP_PASS
# are both set; otherwise RESEND_API_KEY is used. Verify whichever you pick:
#
#   npm run verify:email -- you@example.com
#
#
# TRANSPORT A — SMTP (recommended: reaches ANY recipient, no domain required)
#
# Defaults target Gmail, so only the two credentials below are needed. To use
# Gmail you must create an App Password — an ordinary account password is
# rejected:
#   1. Enable 2-Step Verification  https://myaccount.google.com/signinoptions/two-step-factor
#   2. Create an App Password      https://myaccount.google.com/apppasswords
# Google displays 16 characters in four groups; enter them WITHOUT spaces.
# Free Gmail sending is capped around 500 recipients/day, ample for a demo.
#
# Set EMAIL_FROM to the same mailbox as SMTP_USER: Gmail rewrites a mismatched
# From header anyway, and receivers may score the mismatch as spoofing.
# SMTP_USER="you@gmail.com"
# SMTP_PASS="abcdefghijklmnop"
# EMAIL_FROM="PDF Intelligence <you@gmail.com>"
#
# For a non-Gmail provider, override the endpoint. Use 465 for implicit TLS or
# 587 for STARTTLS — the code selects the mode from the port.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
#
#
# TRANSPORT B — Resend (only worthwhile with a VERIFIED sending domain)
#
# Get a key at https://resend.com (free tier).
#
# SANDBOX LIMITATION (verified in practice, expect this):
#   With EMAIL_FROM set to `onboarding@resend.dev` and no verified domain,
#   Resend delivers ONLY to the address that owns the Resend account. Every
#   other recipient is rejected with 403:
#     "You can only send testing emails to your own email address (...)"
#   Addresses at reserved domains like example.com are rejected with 422.
#
#   This makes Resend unusable for real share invitations until you verify a
#   domain at https://resend.com/domains and point EMAIL_FROM at an address on
#   it (a domain listed as `not_started` is NOT yet verified). Use SMTP above
#   unless you already own a domain.
#
#   Either way the app degrades honestly: the share link is still created, the
#   UI explains why delivery failed, and the link stays copyable.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="PDF Intelligence <onboarding@resend.dev>"


# IMPORTANT: Next.js reads .env.local once at process start, and this app caches
# the parsed result. Adding or changing any variable above requires a full dev
# server restart — a hot reload will not pick it up.


# --- Testing (OPTIONAL) -----------------------------------------------------
# When set, the database integration tests run against this Postgres instead of
# being skipped. Must have the `vector` and `pg_trgm` extensions available.
#
#   docker run -d --name pdfiq-db -e POSTGRES_PASSWORD=testpass \
#     -e POSTGRES_DB=pdfiq -p 55432:5432 pgvector/pgvector:pg17
#
# TEST_DATABASE_URL="postgresql://postgres:testpass@localhost:55432/pdfiq"
